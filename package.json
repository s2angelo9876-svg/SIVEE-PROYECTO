{
  "name": "sivee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "npm run setup:demo && npm run dev:services",
    "dev:services": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "npm run db:generate && npm run typecheck && vite build --config apps/web/vite.config.ts && node scripts/build-api.mjs",
    "start": "node dist/api/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx apps/api/prisma/seed-demo.ts",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "test:unit": "vitest run tests/unit.test.ts tests/roster.test.ts tests/school.test.ts tests/http-recovery.test.ts",
    "test:integration": "tsx tests/integration.ts && tsx tests/roster.integration.ts && tsx tests/official.integration.ts && tsx tests/election-copies.integration.ts",
    "test:copies": "tsx tests/election-copies.integration.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "demo:scenario": "tsx scripts/demo-scenario.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "production:init": "tsx scripts/bootstrap-production.ts",
    "account:recover": "tsx scripts/recover-account.ts",
    "test:production": "node scripts/build-api.mjs && tsx tests/production.integration.ts"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.0",
    "shell-quote": "1.11.0",
    "playwright-core": "1.56.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "fflate": "0.8.3",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.1",
    "esbuild": "0.27.0",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
