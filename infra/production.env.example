# Copy values into Railway Variables; never commit the filled file.
NODE_ENV=production
SIVEE_ENV=production
WEB_ORIGIN=https://YOUR-DOMAIN
COOKIE_SECURE=true
ALLOW_DEMO_RESET=false
TRUST_PROXY_HOPS=1
# Railway supplies PORT. The application serves React and API together.
DATABASE_URL=postgresql://sivee_app:URL_ENCODED_PASSWORD@PRIVATE_HOST:5432/railway
# Three different cryptographically random secrets, at least 32 characters each.
DNI_LOOKUP_KEY=
SESSION_PEPPER=
CSRF_KEY=
INSTITUTIONAL_APPROVAL_REFERENCE=
# Operations service only. Omit these variables from the API service.
MIGRATION_DATABASE_URL=postgresql://OWNER:URL_ENCODED_PASSWORD@PRIVATE_HOST:5432/railway
INSTITUTION_CODE=
INSTITUTION_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
